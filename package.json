{
  "name": "vez-stablecoin-orchestrator",
  "version": "1.0.0",
  "description": "Chainlink CRE workflow for VEZ stablecoin orchestration on Slura chain (chainId 45057)",
  "type": "module",
  "main": "dist/workflow.js",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "simulate": "cre workflow simulate . --target staging-settings --non-interactive --trigger-index 0 --broadcast --env .env --verbose --allow-insecure-rpc"
  },
  "keywords": [
    "chainlink",
    "cre",
    "stablecoin",
    "vez",
    "slura"
  ],
